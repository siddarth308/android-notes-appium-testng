<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Notes App Regression Suite">
    <listeners>
        <listener class-name="reporting.TestListener"/>
    </listeners>

    <test name="Text Notes">
        <classes><class name="tests.TextNoteTests"/></classes>
    </test>
    <test name="Todo Lists">
        <classes><class name="tests.TodoListTests"/></classes>
    </test>
    <test name="Edit and Delete">
        <classes><class name="tests.EditDeleteTests"/></classes>
    </test>
    <test name="Validation">
        <classes><class name="tests.ValidationTests"/></classes>
    </test>
    <test name="List Features">
        <classes><class name="tests.NotesListFeatureTests"/></classes>
    </test>
</suite>
